rules_version = '2';

// Regras do Guia da Feira e do painel MOKI.
// Visitante lê e vota. Grupos editam pelo servidor, com senha por banca.
service cloud.firestore {
  match /databases/{database}/documents {
    // Cardápio, sabores e ficha só mudam pelo servidor do guia, depois do login com a senha da banca.
    match /bancas/{id} { allow read: if true; }
    match /mokiSabores/{id} { allow read: if true; }
    match /mokiFicha/{id} { allow read: if true; }

    match /votos/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['banca', 'nota', 'criadoEm'])
        && request.resource.data.nota is int
        && request.resource.data.nota >= 1 && request.resource.data.nota <= 5
        && exists(/databases/$(database)/documents/bancas/$(request.resource.data.banca));
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
